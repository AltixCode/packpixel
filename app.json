{
  "expo": {
    "name": "PackPixel",
    "slug": "packpixel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "packpixel",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hushtunnel.packpixel",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PackPixel needs photo library access to batch select product photos.",
        "NSPhotoLibraryAddUsageDescription": "PackPixel exports formatted, resized marketplace images to your photo library."
      }
    },
    "android": {
      "package": "com.hushtunnel.packpixel",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}